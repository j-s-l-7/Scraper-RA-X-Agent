# Copy to .env (git-ignored) only if you need to override a default. No real values belong in this file.
# The lake uses trust auth on localhost, so no DSN needs a password. Never put one in a DSN.

# Read path (equity/macro, read-only session) and write path (ideation schema). Both connect as ideation_rw.
IDEATION_LAKE_DSN=postgresql://ideation_rw@localhost:5433/equity_lake
IDEATION_DSN=postgresql://ideation_rw@localhost:5433/equity_lake
# Superuser DSN used ONLY by `ideation bootstrap-role` (one-time role creation, 03 §C1). Defaults to the OS user.
IDEATION_BOOTSTRAP_DSN=postgresql://localhost:5433/equity_lake

# Local artifacts (snapshots, logs, reports, models). Must be outside the repo.
IDEATION_DATA_DIR=~/Ideation-data
IDEATION_STATEMENT_TIMEOUT_S=120
IDEATION_LOG_LEVEL=INFO

# Read-only external sources (never modified by this system).
IDEATION_XAGENT_DB=~/X-Agent/data/xagent.db
IDEATION_LIBRARY_DB=~/Scraper - Screener.in/data/library.sqlite

# Chat (Phase 8). Leave empty here; set it in your shell or in the git-ignored .env.
ANTHROPIC_API_KEY=
